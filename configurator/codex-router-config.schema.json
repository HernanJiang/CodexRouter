{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Router Config",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "deploy": {
      "type": "object",
      "properties": {
        "codexHome": {
          "type": "string"
        },
        "sub2apiHost": {
          "type": "string"
        },
        "ccSwitchDb": {
          "type": "string"
        },
        "generateIsolation": {
          "type": "boolean"
        }
      }
    },
    "oauthFallback": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "officialPriority": {
          "type": "integer"
        },
        "fallbackPriority": {
          "type": "integer"
        }
      }
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "auto"
          ]
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultLevel": {
          "type": "string"
        },
        "supportsFast": {
          "type": "boolean"
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "baseURL": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "weight": {
            "type": "integer"
          },
          "extra": {
            "type": "string"
          },
          "multimodal": {
            "type": "string",
            "enum": [
              "auto",
              "true",
              "false"
            ]
          }
        },
        "required": [
          "model",
          "baseURL",
          "apiKey"
        ]
      }
    },
    "modelCatalog": {
      "type": "array"
    },
    "ccSwitchProviders": {
      "type": "array"
    }
  }
}