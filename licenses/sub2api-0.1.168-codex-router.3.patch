+func TestBeginConnPhase_ExplicitTimeoutMayExceedDefault(t *testing.T) {
+	client, server := net.Pipe()
+	recordingClient := &deadlineRecordingConn{Conn: client}
+	t.Cleanup(func() { _ = recordingClient.Close() })
+	t.Cleanup(func() { _ = server.Close() })
+
+	const configuredTimeout = 20 * time.Second
+	started := time.Now()
+	finish, err := beginConnPhase(context.Background(), recordingClient, configuredTimeout, defaultTLSHandshakeTimeout)
+	require.NoError(t, err)
+	require.NotEmpty(t, recordingClient.deadlines)
+	require.WithinDuration(t, started.Add(configuredTimeout), recordingClient.deadlines[0], time.Second)
+	finish()
+	require.True(t, recordingClient.deadlines[len(recordingClient.deadlines)-1].IsZero())
+}
