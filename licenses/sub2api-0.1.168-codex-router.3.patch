+func nextOpenAICompatibleCompositeCandidate(ctx context.Context, currentPlatform string) (service.CompositeRouteDecision, bool) {
+	candidates := service.CompositeRouteCandidatesFromContext(ctx)
+	if len(candidates) < 2 {
+		return service.CompositeRouteDecision{}, false
+	}
+	currentIndex := -1
+	for i, candidate := range candidates {
+		if candidate.TargetPlatform == currentPlatform {
+			currentIndex = i
+			break
+		}
+	}
+	if currentIndex < 0 {
+		return service.CompositeRouteDecision{}, false
+	}
+	for _, candidate := range candidates[currentIndex+1:] {
+		platform := strings.TrimSpace(candidate.TargetPlatform)
+		if platform != service.PlatformOpenAI && platform != service.PlatformGrok {
+			continue
+		}
+		if platform != currentPlatform {
+			return candidate, true
+		}
+	}
+	return service.CompositeRouteDecision{}, false
+}
+
+func commitCompositeCandidate(c *gin.Context, candidate service.CompositeRouteDecision) {
+	if c == nil || c.Request == nil {
+		return
+	}
+	c.Request = c.Request.WithContext(service.WithCompositeRouteDecision(c.Request.Context(), candidate))
+}
