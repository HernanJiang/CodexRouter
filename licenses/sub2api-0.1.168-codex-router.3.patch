diff --git a/backend/internal/pkg/proxyurl/environment.go b/backend/internal/pkg/proxyurl/environment.go
new file mode 100644
index 0000000..6bd391c
--- /dev/null
+++ b/backend/internal/pkg/proxyurl/environment.go
@@ -0,0 +1,100 @@
+package proxyurl
+
+import (
+	"errors"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+
+	"golang.org/x/net/http/httpproxy"
+)
+
+var errInvalidEnvironmentProxy = errors.New("invalid proxy configuration from environment")
+
+// FromEnvironment preserves net/http's HTTP_PROXY, HTTPS_PROXY and NO_PROXY
+// behavior while validating the selected proxy before the standard library
+// can silently turn a malformed value into a direct connection.
+func FromEnvironment(req *http.Request) (*url.URL, error) {
+	resolved, err := http.ProxyFromEnvironment(req)
+	if err != nil {
+		return nil, err
+	}
+	if req != nil && req.URL != nil {
+		if raw := environmentProxyForScheme(req.URL.Scheme); strings.TrimSpace(raw) != "" {
+			if err := validateEnvironmentProxy(raw); err != nil {
+				// The standard library maps malformed proxy values to nil, which is
+				// indistinguishable from NO_PROXY. Build the matcher only on this rare
+				// error path so localhost/loopback and explicit bypasses still win.
+				if resolved == nil && environmentProxyBypassed(req.URL) {
+					return nil, nil
+				}
+				return nil, errInvalidEnvironmentProxy
+			}
+		}
+	}
+	return resolved, nil
+}
+
+func environmentProxyBypassed(target *url.URL) bool {
+	if target == nil {
+		return false
+	}
+	const sentinelProxy = "http://proxy.invalid"
+	config := &httpproxy.Config{
+		HTTPProxy:  sentinelProxy,
+		HTTPSProxy: sentinelProxy,
+		NoProxy:    firstEnvironmentValue("NO_PROXY", "no_proxy"),
+		CGI:        os.Getenv("REQUEST_METHOD") != "",
+	}
+	resolved, err := config.ProxyFunc()(target)
+	return err == nil && resolved == nil
+}
+
+func environmentProxyForScheme(scheme string) string {
+	switch strings.ToLower(strings.TrimSpace(scheme)) {
+	case "https":
+		return firstEnvironmentValue("HTTPS_PROXY", "https_proxy")
+	case "http":
+		return firstEnvironmentValue("HTTP_PROXY", "http_proxy")
+	default:
+		return ""
+	}
+}
+
+func firstEnvironmentValue(keys ...string) string {
+	for _, key := range keys {
+		if value := os.Getenv(key); value != "" {
+			return value
+		}
+	}
+	return ""
+}
+
+func validateEnvironmentProxy(raw string) error {
+	trimmed := strings.TrimSpace(raw)
+	if trimmed == "" {
+		return nil
+	}
+	parsed, err := url.Parse(trimmed)
+	if err != nil || parsed.Scheme == "" || parsed.Host == "" {
+		// Match net/http compatibility for host:port and authenticated bare
+		// proxy addresses, but do not reinterpret an explicit malformed URL.
+		if strings.Contains(trimmed, "://") {
+			return errInvalidEnvironmentProxy
+		}
+		parsed, err = url.Parse("http://" + trimmed)
+		if err != nil {
+			return errInvalidEnvironmentProxy
+		}
+	}
+	if parsed.Host == "" || parsed.Hostname() == "" {
+		return errInvalidEnvironmentProxy
+	}
+	switch strings.ToLower(parsed.Scheme) {
+	case "http", "https", "socks5", "socks5h":
+		return nil
+	default:
+		return errInvalidEnvironmentProxy
+	}
+}
