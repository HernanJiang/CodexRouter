+// shouldRetryOpenAIProxyDirectFallback only approves failures that happen before
+// an HTTP response and before the request can reasonably have reached the
+// provider. Ambiguous errors such as EOF, connection reset, or a response-header
+// timeout may occur after the provider accepted the request, so replaying those
+// directly could duplicate a non-idempotent Responses request.
+func shouldRetryOpenAIProxyDirectFallback(account *Account, proxyURL string, err error) bool {
+	if account == nil || account.Type != AccountTypeAPIKey || strings.TrimSpace(proxyURL) == "" || err == nil {
+		return false
+	}
+	if !account.getExtraBool(openAIProxyDirectFallbackExtraKey) {
+		return false
+	}
+	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+
+	if errors.Is(err, syscall.ECONNREFUSED) ||
+		errors.Is(err, syscall.EHOSTUNREACH) ||
+		errors.Is(err, syscall.ENETUNREACH) {
+		return true
+	}
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) {
+		return true
+	}
+	var opErr *net.OpError
+	if errors.As(err, &opErr) && strings.EqualFold(strings.TrimSpace(opErr.Op), "dial") {
+		return true
+	}
+
+	message := strings.ToLower(err.Error())
+	for _, marker := range []string{
+		"proxyconnect",
+		"proxy authentication required",
+		"socks connect",
+		"connection refused",
+		"no route to host",
+		"network is unreachable",
+		"no such host",
+		"tls handshake",
+		"x509:",
+	} {
+		if strings.Contains(message, marker) {
+			return true
+		}
+	}
+	return false
+}
