+func TestBeginConnPhase_ClearsDeadlineWithoutCancellationRace(t *testing.T) {
+	client, server := net.Pipe()
+	t.Cleanup(func() { _ = client.Close() })
+	t.Cleanup(func() { _ = server.Close() })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	finish, err := beginConnPhase(ctx, client, 50*time.Millisecond, time.Second)
+	require.NoError(t, err)
+	finish()
+	cancel()
+
+	readDone := make(chan error, 1)
+	go func() {
+		buffer := make([]byte, 1)
+		_, readErr := client.Read(buffer)
+		readDone <- readErr
+	}()
+	require.NoError(t, server.SetWriteDeadline(time.Now().Add(time.Second)))
+	_, err = server.Write([]byte{1})
+	require.NoError(t, err)
+	require.NoError(t, <-readDone, "phase cleanup must not leave a canceled deadline on a pooled connection")
