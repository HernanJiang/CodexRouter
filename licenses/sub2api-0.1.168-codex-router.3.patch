@@ -0,0 +1,122 @@
+package proxyurl
+
+import (
+	"net/http"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestValidateEnvironmentProxy_AcceptsStandardForms(t *testing.T) {
+	for _, value := range []string{
+		"http://127.0.0.1:7897",
+		"https://proxy.example:8443",
+		"socks5h://[::1]:1080",
+		"127.0.0.1:7897",
+		"user:password@proxy.example:8080",
+	} {
+		t.Run(value, func(t *testing.T) {
+			require.NoError(t, validateEnvironmentProxy(value))
+		})
+	}
+}
+
+func TestValidateEnvironmentProxy_RejectsMalformedOrUnsupportedValues(t *testing.T) {
+	for _, value := range []string{
+		"http://private-user:secret%zz@proxy.example:8080",
+		"http://",
+		"file:///local/path",
+		"ftp://proxy.example:21",
+		"://missing-scheme",
+	} {
+		t.Run(value, func(t *testing.T) {
+			err := validateEnvironmentProxy(value)
+			require.ErrorIs(t, err, errInvalidEnvironmentProxy)
+			require.NotContains(t, err.Error(), "private-user")
+			require.NotContains(t, err.Error(), "secret")
+		})
+	}
+}
+
+func TestFromEnvironment_InvalidSelectedProxyFailsClosedWithoutCredentials(t *testing.T) {
+	for _, key := range []string{"HTTPS_PROXY", "https_proxy"} {
+		t.Setenv(key, "")
+	}
+	for _, key := range []string{"NO_PROXY", "no_proxy"} {
+		t.Setenv(key, "")
+	}
+	t.Setenv("HTTPS_PROXY", "http://private-user:secret%zz@proxy.example:8080")
+	req, err := http.NewRequest(http.MethodGet, "https://api.openai.com/v1/responses", nil)
+	require.NoError(t, err)
+
+	_, err = FromEnvironment(req)
+	require.ErrorIs(t, err, errInvalidEnvironmentProxy)
+	require.False(t, strings.Contains(err.Error(), "private-user") || strings.Contains(err.Error(), "secret"))
+}
+
+func TestFromEnvironment_BypassPrecedesMalformedProxyValidation(t *testing.T) {
+	for _, key := range []string{"HTTPS_PROXY", "https_proxy", "NO_PROXY", "no_proxy"} {
+		t.Setenv(key, "")
+	}
+	t.Setenv("HTTPS_PROXY", "http://private-user:secret%zz@proxy.example:8080")
+
+	loopbackReq, err := http.NewRequest(http.MethodGet, "https://127.0.0.1:18080/health", nil)
+	require.NoError(t, err)
+	resolved, err := FromEnvironment(loopbackReq)
+	require.NoError(t, err)
+	require.Nil(t, resolved)
+
+	t.Setenv("NO_PROXY", "api.openai.com")
+	bypassedReq, err := http.NewRequest(http.MethodGet, "https://api.openai.com/v1/responses", nil)
+	require.NoError(t, err)
+	resolved, err = FromEnvironment(bypassedReq)
+	require.NoError(t, err)
+	require.Nil(t, resolved)
+}
+
+func TestFromEnvironment_HonorsStandardNoProxyMatching(t *testing.T) {
+	cmd := exec.Command(os.Args[0], "-test.run=^TestFromEnvironmentNoProxyHelper$")
+	cmd.Env = environmentWithoutProxyVariables(os.Environ())
+	cmd.Env = append(cmd.Env,
+		"SUB2API_PROXY_HELPER=1",
+		"HTTPS_PROXY=http://127.0.0.1:7897",
+		"NO_PROXY=api.openai.com",
+	)
+	output, err := cmd.CombinedOutput()
+	require.NoError(t, err, "proxy helper failed: %s", output)
+}
+
+func TestFromEnvironmentNoProxyHelper(t *testing.T) {
+	if os.Getenv("SUB2API_PROXY_HELPER") != "1" {
+		return
+	}
+	bypassedReq, err := http.NewRequest(http.MethodGet, "https://api.openai.com/v1/responses", nil)
+	require.NoError(t, err)
+	resolved, err := FromEnvironment(bypassedReq)
+	require.NoError(t, err)
+	require.Nil(t, resolved)
+
+	proxiedReq, err := http.NewRequest(http.MethodGet, "https://example.com/v1/responses", nil)
+	require.NoError(t, err)
+	resolved, err = FromEnvironment(proxiedReq)
+	require.NoError(t, err)
+	require.Equal(t, "http://127.0.0.1:7897", resolved.String())
+}
+
+func environmentWithoutProxyVariables(environment []string) []string {
+	filtered := make([]string, 0, len(environment))
+	for _, entry := range environment {
+		key, _, found := strings.Cut(entry, "=")
+		if found {
+			switch strings.ToUpper(key) {
+			case "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "ALL_PROXY", "SUB2API_PROXY_HELPER":
+				continue
+			}
+		}
+		filtered = append(filtered, entry)
+	}
+	return filtered
+}
