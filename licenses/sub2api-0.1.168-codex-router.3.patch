+func (s *HTTPUpstreamSuite) TestOpenAILoopbackProxyIsolatesConcurrentStreams() {
+	var observationsMu sync.Mutex
+	var protocolMajors []int
+	var remoteAddresses []string
+	entered := make(chan struct{}, 2)
+	release := make(chan struct{})
+
+	upstream := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		observationsMu.Lock()
+		protocolMajors = append(protocolMajors, r.ProtoMajor)
+		remoteAddresses = append(remoteAddresses, r.RemoteAddr)
+		observationsMu.Unlock()
+		entered <- struct{}{}
+		<-release
+		_, _ = io.WriteString(w, "data")
+	}))
+	upstream.EnableHTTP2 = true
+	upstream.StartTLS()
+	s.T().Cleanup(upstream.Close)
+
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodConnect {
+			http.Error(w, "CONNECT required", http.StatusMethodNotAllowed)
+			return
+		}
+		upstreamConn, err := net.DialTimeout("tcp", r.Host, 2*time.Second)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadGateway)
+			return
+		}
+		hijacker, ok := w.(http.Hijacker)
+		if !ok {
+			_ = upstreamConn.Close()
+			http.Error(w, "hijacking unavailable", http.StatusInternalServerError)
+			return
+		}
+		clientConn, _, err := hijacker.Hijack()
+		if err != nil {
+			_ = upstreamConn.Close()
+			return
+		}
+		_, _ = clientConn.Write([]byte("HTTP/1.1 200 Connection Established\r\n\r\n"))
+		go func() {
+			defer func() { _ = clientConn.Close() }()
+			defer func() { _ = upstreamConn.Close() }()
+			var copies sync.WaitGroup
+			copies.Add(2)
+			go func() {
+				defer copies.Done()
+				_, _ = io.Copy(upstreamConn, clientConn)
+			}()
+			go func() {
+				defer copies.Done()
+				_, _ = io.Copy(clientConn, upstreamConn)
+			}()
+			copies.Wait()
+		}()
+	}))
+	s.T().Cleanup(proxy.Close)
+
+	s.cfg.Gateway = config.GatewayConfig{
+		OpenAIHTTP2: config.GatewayOpenAIHTTP2Config{Enabled: true},
+	}
+	svc := s.newService()
+	entry, err := svc.getClientEntry(proxy.URL, 1, 2, service.HTTPUpstreamProfileOpenAI, false, false)
+	require.NoError(s.T(), err)
+	transport, ok := entry.client.Transport.(*http.Transport)
+	require.True(s.T(), ok, "expected *http.Transport")
+	trustedTransport, ok := upstream.Client().Transport.(*http.Transport)
+	require.True(s.T(), ok, "expected test server *http.Transport")
+	transport.TLSClientConfig = trustedTransport.TLSClientConfig.Clone()
+
+	results := make(chan error, 2)
+	for range 2 {
+		go func() {
+			resp, requestErr := entry.client.Get(upstream.URL)
+			if requestErr == nil {
+				_, requestErr = io.ReadAll(resp.Body)
+				closeErr := resp.Body.Close()
+				if requestErr == nil {
+					requestErr = closeErr
+				}
+			}
+			results <- requestErr
+		}()
+	}
+	for range 2 {
+		select {
+		case <-entered:
+		case <-time.After(3 * time.Second):
+			close(release)
+			s.T().Fatal("concurrent streams did not reach upstream independently")
+		}
+	}
+	close(release)
+	for range 2 {
+		require.NoError(s.T(), <-results)
+	}
+
+	observationsMu.Lock()
+	defer observationsMu.Unlock()
+	require.Equal(s.T(), []int{1, 1}, protocolMajors)
+	require.Len(s.T(), remoteAddresses, 2)
+	require.NotEqual(s.T(), remoteAddresses[0], remoteAddresses[1], "concurrent HTTP/1.1 streams should use independent proxy tunnels")
+}
