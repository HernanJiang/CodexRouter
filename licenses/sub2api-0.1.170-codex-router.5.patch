+func (s *GrokQuotaService) fetchWebBilling(
+	ctx context.Context,
+	account *Account,
+	token string,
+	proxyURL string,
+) (*xai.BillingSummary, int, error) {
+	var lastStatus int
+	var lastErr error
+	for attempt := 0; attempt < grokBillingMaxAttempts; attempt++ {
+		req, err := http.NewRequestWithContext(
+			ctx,
+			http.MethodPost,
+			xai.WebBillingURL,
+			bytes.NewReader(xai.WebBillingRequestBody()),
+		)
+		if err != nil {
+			return nil, 0, infraerrors.Newf(http.StatusInternalServerError, "GROK_QUOTA_PROBE_REQUEST_BUILD_FAILED", "failed to build web billing request: %v", err)
+		}
+		xai.ApplyWebBillingHeaders(req, token)
+		account.ApplyHeaderOverrides(req.Header)
+		resp, requestErr := s.httpUpstream.Do(req, proxyURL, account.ID, maxInt(account.Concurrency, 1))
+		if requestErr != nil {
+			lastStatus = 0
+			lastErr = infraerrors.Newf(http.StatusBadGateway, "GROK_QUOTA_PROBE_REQUEST_FAILED", "web billing request failed: %v", requestErr)
+		} else {
+			statusCode := resp.StatusCode
+			bodyBytes, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+			_ = resp.Body.Close()
+			lastStatus = statusCode
+			if statusCode >= 400 {
+				lastErr = infraerrors.Newf(mapUpstreamStatus(statusCode), "GROK_QUOTA_PROBE_UPSTREAM_ERROR", "web billing returned %d", statusCode)
+			} else if grpcErr := xai.ClassifyWebBillingGRPCHeaders(resp.Header); grpcErr != nil {
+				lastErr = grokWebBillingError(grpcErr)
+			} else {
+				summary, parseErr := xai.ParseWebBillingResponse(bodyBytes, time.Now().UTC())
+				if parseErr == nil {
+					return summary, statusCode, nil
+				}
+				lastErr = grokWebBillingError(parseErr)
+			}
+		}
+
+		if attempt+1 >= grokBillingMaxAttempts || !isRetryableGrokWebBillingFailure(lastStatus, lastErr) {
+			return nil, lastStatus, lastErr
+		}
+		if err := waitForGrokBillingRetry(ctx); err != nil {
+			return nil, lastStatus, err
+		}
+	}
+	return nil, lastStatus, lastErr
+}
+
+func grokBillingSummaryHasWeeklyQuota(summary *xai.BillingSummary) bool {
+	return summary != nil && summary.UsagePercent != nil
+}
+
+func grokWebBillingError(err error) error {
+	var rpcErr *xai.WebBillingRPCError
+	if errors.As(err, &rpcErr) && rpcErr.Unauthorized {
+		return infraerrors.New(http.StatusUnauthorized, "GROK_QUOTA_REAUTH_REQUIRED", "Grok web billing rejected credentials")
+	}
+	return infraerrors.Newf(http.StatusBadGateway, "GROK_QUOTA_BILLING_PARSE_ERROR", "failed to parse web billing body: %v", err)
+}
+
+func isRetryableGrokWebBillingFailure(statusCode int, err error) bool {
+	if statusCode == 0 || isRetryableGrokBillingStatus(statusCode) {
+		var rpcErr *xai.WebBillingRPCError
+		return !errors.As(err, &rpcErr) || !rpcErr.Unauthorized
+	}
+	return false
+}
+
+func waitForGrokBillingRetry(ctx context.Context) error {
+	timer := time.NewTimer(grokBillingRetryDelay)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-ctx.Done():
+		return infraerrors.Newf(http.StatusBadGateway, "GROK_QUOTA_PROBE_REQUEST_FAILED", "billing request failed: %v", ctx.Err())
+	}
+}
