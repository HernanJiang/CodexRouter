diff --git a/backend/internal/pkg/xai/web_billing.go b/backend/internal/pkg/xai/web_billing.go
new file mode 100644
index 0000000000000000000000000000000000000000..c24d7f1fae8bbbe128a630be8c10ee3ad9d32849
--- /dev/null
+++ b/backend/internal/pkg/xai/web_billing.go
@@ -0,0 +1,358 @@
+package xai
+
+import (
+	"encoding/binary"
+	"fmt"
+	"math"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const WebBillingURL = "https://grok.com/grok_api_v2.GrokBuildBilling/GetGrokCreditsConfig"
+
+func WebBillingRequestBody() []byte {
+	return []byte{0, 0, 0, 0, 0}
+}
+
+func ApplyWebBillingHeaders(req *http.Request, accessToken string) {
+	if req == nil {
+		return
+	}
+	if token := strings.TrimSpace(accessToken); token != "" {
+		req.Header.Set("Authorization", "Bearer "+token)
+	}
+	req.Header.Set(CLITokenAuthHeader, CLITokenAuthValue)
+	req.Header.Set("Accept", "application/grpc-web+proto")
+	req.Header.Set("Content-Type", "application/grpc-web+proto")
+	req.Header.Set("Origin", "https://grok.com")
+	req.Header.Set("Referer", "https://grok.com/?_s=usage")
+	req.Header.Set("User-Agent", "Grok Build")
+	req.Header.Set("x-grpc-web", "1")
+	req.Header.Set("x-user-agent", "connect-es/2.1.1")
+}
+
+type grokProtoVarintField struct {
+	path  []int
+	value uint64
+	order int
+}
+
+type grokProtoFloatField struct {
+	path  []int
+	value float32
+	order int
+}
+
+type grokProtoScan struct {
+	varints []grokProtoVarintField
+	floats  []grokProtoFloatField
+	order   int
+}
+
+// WebBillingRPCError preserves the gRPC-Web status separately from an HTTP
+// transport or protobuf parsing error so callers can trigger re-authentication.
+type WebBillingRPCError struct {
+	GRPCStatus   string
+	Message      string
+	Unauthorized bool
+}
+
+func (e *WebBillingRPCError) Error() string {
+	if e == nil {
+		return "Grok web billing RPC failed"
+	}
+	if e.Message == "" {
+		return fmt.Sprintf("Grok web billing RPC failed with gRPC status %s", e.GRPCStatus)
+	}
+	return fmt.Sprintf("Grok web billing RPC failed with gRPC status %s: %s", e.GRPCStatus, e.Message)
+}
+
+// ClassifyWebBillingGRPCStatus validates a response/header gRPC status. A
+// status of 16 is the common expired-token response; status 7 is only treated
+// as authentication failure when its message identifies bad credentials.
+func ClassifyWebBillingGRPCStatus(status, message string) error {
+	status = strings.TrimSpace(status)
+	if status == "" || status == "0" {
+		return nil
+	}
+	if decoded, err := url.QueryUnescape(strings.TrimSpace(message)); err == nil {
+		message = decoded
+	}
+	lower := strings.ToLower(strings.TrimSpace(message))
+	unauthorized := status == "16"
+	if status == "7" {
+		unauthorized = strings.Contains(lower, "bad-credentials") ||
+			strings.Contains(lower, "unauthenticated") ||
+			(strings.Contains(lower, "oauth2") && strings.Contains(lower, "could not be validated")) ||
+			(strings.Contains(lower, "access token") && (strings.Contains(lower, "invalid") ||
+				strings.Contains(lower, "expired") || strings.Contains(lower, "could not be validated")))
+	}
+	return &WebBillingRPCError{GRPCStatus: status, Message: strings.TrimSpace(message), Unauthorized: unauthorized}
+}
+
+// ClassifyWebBillingGRPCHeaders handles non-canonical header maps produced by
+// proxies and test transports while preserving HTTP's case-insensitive keys.
+func ClassifyWebBillingGRPCHeaders(header http.Header) error {
+	return ClassifyWebBillingGRPCStatus(
+		webBillingHeaderValue(header, "grpc-status"),
+		webBillingHeaderValue(header, "grpc-message"),
+	)
+}
+
+func webBillingHeaderValue(header http.Header, name string) string {
+	for key, values := range header {
+		if strings.EqualFold(key, name) && len(values) > 0 {
+			return values[0]
+		}
+	}
+	return ""
+}
+
+// ParseWebBillingResponse reads Grok's gRPC-Web response without depending on
+// its unstable protobuf schema. The useful percentage and period fields have
+// retained their wire paths across the observed response variants.
+func ParseWebBillingResponse(body []byte, now time.Time) (*BillingSummary, error) {
+	payloads, trailers, framed := parseGrokGRPCWebFrames(body)
+	if framed {
+		if err := ClassifyWebBillingGRPCStatus(trailers["grpc-status"], trailers["grpc-message"]); err != nil {
+			return nil, err
+		}
+	} else if looksLikeGrokProtobuf(body) {
+		payloads = [][]byte{body}
+	} else {
+		return nil, fmt.Errorf("Grok web billing returned no protobuf payload")
+	}
+
+	var scan grokProtoScan
+	for _, payload := range payloads {
+		scanGrokProto(payload, nil, 0, &scan)
+	}
+	percent := grokBillingPercent(scan)
+	reset, start := grokBillingTimes(scan, now)
+	if percent == nil {
+		if len(scan.floats) != 0 || reset == nil || !grokBillingHasUsagePeriod(scan) {
+			return nil, fmt.Errorf("could not parse Grok web billing usage")
+		}
+		zero := float64(0)
+		percent = &zero
+	}
+
+	summary := &BillingSummary{
+		PeriodType:   grokBillingPeriodType(start, reset),
+		UsagePercent: percent,
+		Source:       "web_billing_probe",
+	}
+	if start != nil {
+		summary.PeriodStart = start.UTC().Format(time.RFC3339)
+	}
+	if reset != nil {
+		summary.PeriodEnd = reset.UTC().Format(time.RFC3339)
+	}
+	return summary, nil
+}
+
+func grokBillingPeriodType(start, reset *time.Time) string {
+	if start == nil || reset == nil || !reset.After(*start) {
+		return "weekly"
+	}
+	days := reset.Sub(*start).Hours() / 24
+	if days >= 20 && days <= 45 {
+		return "monthly"
+	}
+	return "weekly"
+}
+
+func parseGrokGRPCWebFrames(body []byte) ([][]byte, map[string]string, bool) {
+	trailers := make(map[string]string)
+	if len(body) < 5 {
+		return nil, trailers, false
+	}
+	payloads := make([][]byte, 0, 1)
+	for offset := 0; offset < len(body); {
+		if offset+5 > len(body) {
+			return nil, trailers, false
+		}
+		flags := body[offset]
+		length := int(binary.BigEndian.Uint32(body[offset+1 : offset+5]))
+		start := offset + 5
+		end := start + length
+		if end < start || end > len(body) {
+			return nil, trailers, false
+		}
+		frame := body[start:end]
+		if flags&0x80 != 0 {
+			text := strings.ReplaceAll(string(frame), "\r\n", "\n")
+			for _, line := range strings.Split(text, "\n") {
+				key, value, ok := strings.Cut(line, ":")
+				if ok && strings.TrimSpace(key) != "" {
+					trailers[strings.ToLower(strings.TrimSpace(key))] = strings.TrimSpace(value)
+				}
+			}
+		} else {
+			payloads = append(payloads, append([]byte(nil), frame...))
+		}
+		offset = end
+	}
+	return payloads, trailers, true
+}
+
+func looksLikeGrokProtobuf(body []byte) bool {
+	if len(body) == 0 {
+		return false
+	}
+	field := body[0] >> 3
+	wireType := body[0] & 7
+	return field > 0 && (wireType == 0 || wireType == 1 || wireType == 2 || wireType == 5)
+}
+
+func scanGrokProto(data []byte, path []int, depth int, scan *grokProtoScan) {
+	if len(data) == 0 || depth > 8 || scan == nil {
+		return
+	}
+	for offset := 0; offset < len(data); {
+		key, next, ok := readGrokProtoVarint(data, offset)
+		if !ok {
+			return
+		}
+		offset = next
+		field := int(key >> 3)
+		wireType := int(key & 7)
+		if field <= 0 {
+			return
+		}
+		nextPath := append(append([]int(nil), path...), field)
+		switch wireType {
+		case 0:
+			value, nextOffset, valid := readGrokProtoVarint(data, offset)
+			if !valid {
+				return
+			}
+			scan.varints = append(scan.varints, grokProtoVarintField{
+				path: nextPath, value: value, order: scan.order,
+			})
+			scan.order++
+			offset = nextOffset
+		case 1:
+			if offset+8 > len(data) {
+				return
+			}
+			offset += 8
+		case 2:
+			length, nextOffset, valid := readGrokProtoVarint(data, offset)
+			if !valid || length > uint64(len(data)-nextOffset) {
+				return
+			}
+			offset = nextOffset
+			end := offset + int(length)
+			if length > 0 {
+				scanGrokProto(data[offset:end], nextPath, depth+1, scan)
+			}
+			offset = end
+		case 5:
+			if offset+4 > len(data) {
+				return
+			}
+			scan.floats = append(scan.floats, grokProtoFloatField{
+				path:  nextPath,
+				value: math.Float32frombits(binary.LittleEndian.Uint32(data[offset : offset+4])),
+				order: scan.order,
+			})
+			scan.order++
+			offset += 4
+		default:
+			return
+		}
+	}
+}
+
+func readGrokProtoVarint(data []byte, offset int) (uint64, int, bool) {
+	var value uint64
+	for shift := uint(0); offset < len(data) && shift <= 63; shift += 7 {
+		byteValue := data[offset]
+		offset++
+		value |= uint64(byteValue&0x7f) << shift
+		if byteValue&0x80 == 0 {
+			return value, offset, true
+		}
+	}
+	return 0, offset, false
+}
+
+func grokBillingPercent(scan grokProtoScan) *float64 {
+	var selected *grokProtoFloatField
+	for index := range scan.floats {
+		field := &scan.floats[index]
+		value := float64(field.value)
+		if len(field.path) == 0 || field.path[len(field.path)-1] != 1 ||
+			math.IsNaN(value) || math.IsInf(value, 0) || field.value < 0 || field.value > 100 {
+			continue
+		}
+		if selected == nil || len(field.path) < len(selected.path) ||
+			(len(field.path) == len(selected.path) && field.order < selected.order) {
+			selected = field
+		}
+	}
+	if selected == nil {
+		return nil
+	}
+	value := float64(selected.value)
+	return &value
+}
+
+func grokBillingTimes(scan grokProtoScan, now time.Time) (*time.Time, *time.Time) {
+	now = now.UTC()
+	var reset *time.Time
+	var start *time.Time
+	future := make([]grokProtoVarintField, 0)
+	for _, field := range scan.varints {
+		if field.value < 1_700_000_000 || field.value > 2_100_000_000 {
+			continue
+		}
+		value := time.Unix(int64(field.value), 0).UTC()
+		if value.After(now) {
+			future = append(future, field)
+		}
+		if grokProtoPath(field.path) == "1.4.1" && (start == nil || value.After(*start)) {
+			copy := value
+			start = &copy
+		}
+	}
+	for _, field := range future {
+		value := time.Unix(int64(field.value), 0).UTC()
+		if grokProtoPath(field.path) == "1.5.1" && (reset == nil || value.Before(*reset)) {
+			copy := value
+			reset = &copy
+		}
+	}
+	if reset == nil {
+		for _, field := range future {
+			value := time.Unix(int64(field.value), 0).UTC()
+			if reset == nil || value.Before(*reset) {
+				copy := value
+				reset = &copy
+			}
+		}
+	}
+	return reset, start
+}
+
+func grokBillingHasUsagePeriod(scan grokProtoScan) bool {
+	for _, field := range scan.varints {
+		path := grokProtoPath(field.path)
+		if strings.HasPrefix(path, "1.6") || (path == "1.8.1" && (field.value == 1 || field.value == 2)) {
+			return true
+		}
+	}
+	return false
+}
+
+func grokProtoPath(path []int) string {
+	values := make([]string, len(path))
+	for index, value := range path {
+		values[index] = strconv.Itoa(value)
+	}
+	return strings.Join(values, ".")
+}
diff --git a/backend/internal/pkg/xai/web_billing_test.go b/backend/internal/pkg/xai/web_billing_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1a404f8566795c978eb94db0f3eed7cfeb8c7269
--- /dev/null
+++ b/backend/internal/pkg/xai/web_billing_test.go
@@ -0,0 +1,171 @@
+//go:build unit
+
+package xai
+
+import (
+	"encoding/binary"
+	"math"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func appendTestVarint(target []byte, value uint64) []byte {
+	for value >= 0x80 {
+		target = append(target, byte(value&0x7f)|0x80)
+		value >>= 7
+	}
+	return append(target, byte(value))
+}
+
+func testProtoVarint(field int, value uint64) []byte {
+	result := appendTestVarint(nil, uint64(field<<3))
+	return appendTestVarint(result, value)
+}
+
+func testProtoFloat(field int, value float32) []byte {
+	result := appendTestVarint(nil, uint64(field<<3|5))
+	data := make([]byte, 4)
+	binary.LittleEndian.PutUint32(data, math.Float32bits(value))
+	return append(result, data...)
+}
+
+func testProtoBytes(field int, payload []byte) []byte {
+	result := appendTestVarint(nil, uint64(field<<3|2))
+	result = appendTestVarint(result, uint64(len(payload)))
+	return append(result, payload...)
+}
+
+func testGRPCWebFrame(flags byte, payload []byte) []byte {
+	result := make([]byte, 5, 5+len(payload))
+	result[0] = flags
+	binary.BigEndian.PutUint32(result[1:5], uint32(len(payload)))
+	return append(result, payload...)
+}
+
+func testWebBillingPayload(percent *float32, start, end int64, includeUsagePeriod bool) []byte {
+	billing := make([]byte, 0)
+	if percent != nil {
+		billing = append(billing, testProtoFloat(1, *percent)...)
+	}
+	billing = append(billing, testProtoBytes(4, testProtoVarint(1, uint64(start)))...)
+	billing = append(billing, testProtoBytes(5, testProtoVarint(1, uint64(end)))...)
+	if includeUsagePeriod {
+		billing = append(billing, testProtoVarint(6, 1)...)
+	}
+	return testProtoBytes(1, billing)
+}
+
+func TestWebBillingRequestShape(t *testing.T) {
+	t.Parallel()
+
+	require.Equal(t, []byte{0, 0, 0, 0, 0}, WebBillingRequestBody())
+	req, err := http.NewRequest(http.MethodPost, WebBillingURL, nil)
+	require.NoError(t, err)
+	ApplyWebBillingHeaders(req, " token ")
+
+	require.Equal(t, "Bearer token", req.Header.Get("Authorization"))
+	require.Equal(t, CLITokenAuthValue, req.Header.Get(CLITokenAuthHeader))
+	require.Equal(t, "application/grpc-web+proto", req.Header.Get("Content-Type"))
+	require.Equal(t, "https://grok.com", req.Header.Get("Origin"))
+	require.Equal(t, "https://grok.com/?_s=usage", req.Header.Get("Referer"))
+	require.Equal(t, "1", req.Header.Get("x-grpc-web"))
+	require.Equal(t, "connect-es/2.1.1", req.Header.Get("x-user-agent"))
+}
+
+func TestParseWebBillingResponseReadsPercentAndPeriod(t *testing.T) {
+	t.Parallel()
+
+	now := time.Date(2026, 8, 7, 0, 0, 0, 0, time.UTC)
+	start := now.Add(-24 * time.Hour).Unix()
+	end := now.Add(6 * 24 * time.Hour).Unix()
+	percent := float32(42.5)
+	body := testGRPCWebFrame(0, testWebBillingPayload(&percent, start, end, true))
+	body = append(body, testGRPCWebFrame(0x80, []byte("grpc-status: 0\r\n"))...)
+
+	summary, err := ParseWebBillingResponse(body, now)
+	require.NoError(t, err)
+	require.NotNil(t, summary)
+	require.Equal(t, "weekly", summary.PeriodType)
+	require.InDelta(t, 42.5, *summary.UsagePercent, 1e-6)
+	require.Equal(t, time.Unix(start, 0).UTC().Format(time.RFC3339), summary.PeriodStart)
+	require.Equal(t, time.Unix(end, 0).UTC().Format(time.RFC3339), summary.PeriodEnd)
+}
+
+func TestParseWebBillingResponseClassifiesMonthlyPeriod(t *testing.T) {
+	t.Parallel()
+
+	now := time.Date(2026, 8, 7, 0, 0, 0, 0, time.UTC)
+	percent := float32(12.5)
+	body := testGRPCWebFrame(0, testWebBillingPayload(&percent, now.Add(-30*24*time.Hour).Unix(), now.Add(24*time.Hour).Unix(), true))
+
+	summary, err := ParseWebBillingResponse(body, now)
+	require.NoError(t, err)
+	require.Equal(t, "monthly", summary.PeriodType)
+}
+
+func TestParseWebBillingResponseTreatsUnusedPeriodAsZero(t *testing.T) {
+	t.Parallel()
+
+	now := time.Date(2026, 8, 7, 0, 0, 0, 0, time.UTC)
+	body := testGRPCWebFrame(0, testWebBillingPayload(nil, now.Unix(), now.Add(7*24*time.Hour).Unix(), true))
+
+	summary, err := ParseWebBillingResponse(body, now)
+	require.NoError(t, err)
+	require.NotNil(t, summary)
+	require.NotNil(t, summary.UsagePercent)
+	require.Zero(t, *summary.UsagePercent)
+}
+
+func TestParseWebBillingResponseRejectsGRPCErrorTrailer(t *testing.T) {
+	t.Parallel()
+
+	now := time.Date(2026, 8, 7, 0, 0, 0, 0, time.UTC)
+	percent := float32(10)
+	body := testGRPCWebFrame(0, testWebBillingPayload(&percent, now.Unix(), now.Add(7*24*time.Hour).Unix(), true))
+	body = append(body, testGRPCWebFrame(0x80, []byte("grpc-status: 16\r\ngrpc-message: unauthenticated\r\n"))...)
+
+	summary, err := ParseWebBillingResponse(body, now)
+	require.Error(t, err)
+	require.Nil(t, summary)
+	require.Contains(t, err.Error(), "gRPC status 16")
+	var rpcErr *WebBillingRPCError
+	require.ErrorAs(t, err, &rpcErr)
+	require.True(t, rpcErr.Unauthorized)
+}
+
+func TestParseWebBillingResponseRejectsUnrecognizedFixed32Usage(t *testing.T) {
+	t.Parallel()
+
+	now := time.Date(2026, 8, 7, 0, 0, 0, 0, time.UTC)
+	percent := float32(101)
+	body := testGRPCWebFrame(0, testWebBillingPayload(&percent, now.Unix(), now.Add(7*24*time.Hour).Unix(), true))
+
+	_, err := ParseWebBillingResponse(body, now)
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "could not parse")
+}
+
+func TestClassifyWebBillingGRPCStatus(t *testing.T) {
+	t.Parallel()
+
+	require.NoError(t, ClassifyWebBillingGRPCStatus("0", ""))
+	err := ClassifyWebBillingGRPCStatus("7", "access token expired")
+	var rpcErr *WebBillingRPCError
+	require.ErrorAs(t, err, &rpcErr)
+	require.True(t, rpcErr.Unauthorized)
+	require.False(t, (&WebBillingRPCError{GRPCStatus: "13", Message: "upstream"}).Unauthorized)
+}
+
+func TestClassifyWebBillingGRPCHeadersIgnoresHeaderCase(t *testing.T) {
+	err := ClassifyWebBillingGRPCHeaders(http.Header{
+		"grpc-status":  []string{"16"},
+		"grpc-message": []string{"access%20token%20expired"},
+	})
+	require.Error(t, err)
+	var rpcErr *WebBillingRPCError
+	require.ErrorAs(t, err, &rpcErr)
+	require.True(t, rpcErr.Unauthorized)
+}
