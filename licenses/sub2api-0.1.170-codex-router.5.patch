+func appendGrokTestVarint(target []byte, value uint64) []byte {
+	for value >= 0x80 {
+		target = append(target, byte(value&0x7f)|0x80)
+		value >>= 7
+	}
+	return append(target, byte(value))
+}
+
+func grokTestProtoVarint(field int, value uint64) []byte {
+	result := appendGrokTestVarint(nil, uint64(field<<3))
+	return appendGrokTestVarint(result, value)
+}
+
+func grokTestProtoFloat(field int, value float32) []byte {
+	result := appendGrokTestVarint(nil, uint64(field<<3|5))
+	data := make([]byte, 4)
+	binary.LittleEndian.PutUint32(data, math.Float32bits(value))
+	return append(result, data...)
+}
+
+func grokTestProtoBytes(field int, payload []byte) []byte {
+	result := appendGrokTestVarint(nil, uint64(field<<3|2))
+	result = appendGrokTestVarint(result, uint64(len(payload)))
+	return append(result, payload...)
+}
+
+func grokTestWebBillingBody(percent float32, start, end int64) []byte {
+	billing := grokTestProtoFloat(1, percent)
+	billing = append(billing, grokTestProtoBytes(4, grokTestProtoVarint(1, uint64(start)))...)
+	billing = append(billing, grokTestProtoBytes(5, grokTestProtoVarint(1, uint64(end)))...)
+	billing = append(billing, grokTestProtoVarint(6, 1)...)
+	payload := grokTestProtoBytes(1, billing)
+	frame := make([]byte, 5, 5+len(payload))
+	binary.BigEndian.PutUint32(frame[1:5], uint32(len(payload)))
+	return append(frame, payload...)
+}
