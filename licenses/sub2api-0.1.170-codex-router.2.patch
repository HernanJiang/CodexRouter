+// SanitizeOpenAICrossProviderContinuationArtifacts removes continuation state
+// that is scoped to the upstream which produced it. A fallback API-key account
+// cannot safely resolve an OAuth response ID, input item ID, encrypted reasoning,
+// or item_reference, even when the client supplies the rest of the conversation.
+// call_id is deliberately preserved so tool calls and their outputs remain paired.
+//
+// This sanitizer is target-driven rather than attempt-order-driven: it is safe to
+// use when the OAuth account was already quota-isolated before the request and the
+// API-key fallback is therefore the first account attempted by the handler.
+func SanitizeOpenAICrossProviderContinuationArtifacts(body []byte) (sanitized []byte, changed bool, err error) {
+	if len(body) == 0 || !hasOpenAICrossProviderContinuationArtifacts(body) {
+		return body, false, nil
+	}
+
+	var decoded map[string]any
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.UseNumber()
+	if err := decoder.Decode(&decoded); err != nil {
+		return body, false, fmt.Errorf("decode cross-provider continuation body: %w", err)
+	}
+
+	if _, has := decoded["previous_response_id"]; has {
+		delete(decoded, "previous_response_id")
+		changed = true
+	}
+	if sanitizeOpenAICrossProviderInputItems(decoded) {
+		changed = true
+	}
+	if !changed {
+		return body, false, nil
+	}
+
+	out, marshalErr := marshalOpenAIUpstreamJSON(decoded)
+	if marshalErr != nil {
+		return body, false, fmt.Errorf("serialize cross-provider continuation body: %w", marshalErr)
+	}
+	return out, true, nil
+}
+
+func hasOpenAICrossProviderContinuationArtifacts(body []byte) bool {
+	if gjson.GetBytes(body, "previous_response_id").Exists() {
+		return true
+	}
+	input := gjson.GetBytes(body, "input")
+	if input.IsObject() {
+		return openAIInputItemHasProviderContinuationArtifact(input)
+	}
+	if !input.IsArray() {
+		return false
+	}
+	found := false
+	input.ForEach(func(_, item gjson.Result) bool {
+		if openAIInputItemHasProviderContinuationArtifact(item) {
+			found = true
+			return false
+		}
+		return true
+	})
+	return found
+}
+
+func openAIInputItemHasProviderContinuationArtifact(item gjson.Result) bool {
+	if !item.IsObject() {
+		return false
+	}
+	if item.Get("id").Exists() || item.Get("encrypted_content").Exists() {
+		return true
+	}
+	return strings.TrimSpace(item.Get("type").String()) == "item_reference"
+}
+
+func sanitizeOpenAICrossProviderInputItems(reqBody map[string]any) bool {
+	inputValue, has := reqBody["input"]
+	if !has {
+		return false
+	}
+
+	switch input := inputValue.(type) {
+	case []any:
+		filtered := make([]any, 0, len(input))
+		changed := false
+		for _, item := range input {
+			nextItem, itemChanged, keep := sanitizeOpenAICrossProviderInputItem(item)
+			changed = changed || itemChanged
+			if keep {
+				filtered = append(filtered, nextItem)
+			}
+		}
+		if changed {
+			reqBody["input"] = filtered
+		}
+		return changed
+	case []map[string]any:
+		filtered := make([]map[string]any, 0, len(input))
+		changed := false
+		for _, item := range input {
+			nextItem, itemChanged, keep := sanitizeOpenAICrossProviderInputItem(item)
+			changed = changed || itemChanged
+			if !keep {
+				continue
+			}
+			nextMap, ok := nextItem.(map[string]any)
+			if ok {
+				filtered = append(filtered, nextMap)
+			}
+		}
+		if changed {
+			reqBody["input"] = filtered
+		}
+		return changed
+	case map[string]any:
+		nextItem, changed, keep := sanitizeOpenAICrossProviderInputItem(input)
+		if !changed {
+			return false
+		}
+		if !keep {
+			delete(reqBody, "input")
+			return true
+		}
+		reqBody["input"] = nextItem
+		return true
+	default:
+		return false
+	}
+}
+
+func sanitizeOpenAICrossProviderInputItem(item any) (next any, changed bool, keep bool) {
+	inputItem, ok := item.(map[string]any)
+	if !ok {
+		return item, false, true
+	}
+
+	itemType, _ := inputItem["type"].(string)
+	itemType = strings.TrimSpace(itemType)
+	if itemType == "item_reference" {
+		return nil, true, false
+	}
+	if _, encrypted := inputItem["encrypted_content"]; encrypted {
+		switch itemType {
+		case "reasoning", "compaction", "compaction_summary":
+			return nil, true, false
+		}
+	}
+	if _, has := inputItem["id"]; has {
+		delete(inputItem, "id")
+		changed = true
+	}
+	return inputItem, changed, true
+}
