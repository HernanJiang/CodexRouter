+func openAIContinuationOriginCacheKey(sessionHash string) string {
+	normalized := strings.TrimSpace(sessionHash)
+	if normalized == "" {
+		return ""
+	}
+	return openAIContinuationOriginCachePrefix + normalized
+}
+
+// GetOpenAIContinuationOriginAccountID returns the account which last completed
+// a semantic turn for this conversation. This is intentionally separate from
+// scheduler stickiness: routing preference may move when OAuth quota is exhausted,
+// while provider-scoped reasoning and tool state remains owned by its producer.
+func (s *OpenAIGatewayService) GetOpenAIContinuationOriginAccountID(
+	ctx context.Context,
+	groupID *int64,
+	sessionHash string,
+) (int64, error) {
+	if s == nil || s.cache == nil {
+		return 0, nil
+	}
+	cacheKey := openAIContinuationOriginCacheKey(sessionHash)
+	if cacheKey == "" {
+		return 0, nil
+	}
+	accountID, err := s.cache.GetSessionAccountID(ctx, derefGroupID(groupID), cacheKey)
+	if errors.Is(err, ErrStickySessionNotFound) {
+		return 0, nil
+	}
+	return accountID, err
+}
+
+// BindOpenAIContinuationOriginAccount commits continuation ownership only after
+// a forward has produced a scheduling-successful result. The bounded detached
+// context lets the tiny Redis write finish after a client closes a completed
+// stream without extending request lifetime indefinitely.
+func (s *OpenAIGatewayService) BindOpenAIContinuationOriginAccount(
+	ctx context.Context,
+	groupID *int64,
+	sessionHash string,
+	accountID int64,
+) error {
+	if s == nil || s.cache == nil || accountID <= 0 {
+		return nil
+	}
+	cacheKey := openAIContinuationOriginCacheKey(sessionHash)
+	if cacheKey == "" {
+		return nil
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	} else {
+		ctx = context.WithoutCancel(ctx)
+	}
+	cacheCtx, cancel := context.WithTimeout(ctx, openAIWSStateStoreRedisTimeout)
+	defer cancel()
+	return s.cache.SetSessionAccountID(
+		cacheCtx,
+		derefGroupID(groupID),
+		cacheKey,
+		accountID,
+		s.openAIWSSessionStickyTTL(),
+	)
+}
