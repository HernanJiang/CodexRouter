+// IsCodexRouterOAuthFallback reports whether this API-key account is explicitly
+// managed as a cross-provider fallback for an OAuth route. Standalone API-key
+// channels must not set this flag because their own encrypted continuation state
+// remains valid on subsequent requests to the same upstream.
+func (a *Account) IsCodexRouterOAuthFallback() bool {
+	if a == nil || a.Type != AccountTypeAPIKey || a.Extra == nil {
+		return false
+	}
+	enabled, ok := a.Extra["codex_router_oauth_fallback"].(bool)
+	return ok && enabled
+}
