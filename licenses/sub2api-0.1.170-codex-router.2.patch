+		require.False(t, item.Get("id").Exists(), "foreign upstream must not receive provider-scoped item IDs")
+		return true
+	})
+	require.Equal(t, "call_123", gjson.GetBytes(body, `input.#(type=="function_call").call_id`).String())
+	require.Equal(t, "call_123", gjson.GetBytes(body, `input.#(type=="function_call_output").call_id`).String())
+}
