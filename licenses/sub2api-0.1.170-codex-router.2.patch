+			{"type":"item_reference","id":"item_owner"},
+			{"type":"function_call","id":"fc_owner","call_id":"call_123","name":"shell_command","arguments":"{}"},
+			{"type":"function_call_output","id":"out_owner","call_id":"call_123","output":"done"},
+			{"type":"message","id":"msg_owner","role":"user","content":"continue"}
+		]
+	}`)
+}
