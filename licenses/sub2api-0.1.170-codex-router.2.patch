+func TestSanitizeOpenAICrossProviderContinuationArtifacts(t *testing.T) {
+	body := []byte(`{
+		"model":"gpt-5.6-sol",
+		"previous_response_id":"resp_oauth",
+		"input":[
+			{"type":"message","id":"msg_oauth","role":"assistant","content":"hello"},
+			{"type":"reasoning","id":"rs_oauth","encrypted_content":"ENC","summary":[]},
+			{"type":"compaction","id":"cmp_oauth","encrypted_content":"CMP"},
+			{"type":"function_call","id":"fc_oauth","call_id":"call_1","name":"shell","arguments":"{}"},
+			{"type":"item_reference","id":"item_oauth"},
+			{"type":"function_call_output","id":"output_oauth","call_id":"call_1","output":"ok"}
+		],
+		"metadata":{"sequence":9007199254740993}
+	}`)
+
+	sanitized, changed, err := SanitizeOpenAICrossProviderContinuationArtifacts(body)
+	require.NoError(t, err)
+	require.True(t, changed)
+	require.False(t, gjson.GetBytes(sanitized, "previous_response_id").Exists())
+	require.Equal(t, int64(3), gjson.GetBytes(sanitized, "input.#").Int())
+	require.Equal(t, "message", gjson.GetBytes(sanitized, "input.0.type").String())
+	require.False(t, gjson.GetBytes(sanitized, "input.0.id").Exists())
+	require.Equal(t, "function_call", gjson.GetBytes(sanitized, "input.1.type").String())
+	require.False(t, gjson.GetBytes(sanitized, "input.1.id").Exists())
+	require.Equal(t, "call_1", gjson.GetBytes(sanitized, "input.1.call_id").String())
+	require.Equal(t, "function_call_output", gjson.GetBytes(sanitized, "input.2.type").String())
+	require.False(t, gjson.GetBytes(sanitized, "input.2.id").Exists())
+	require.Equal(t, "call_1", gjson.GetBytes(sanitized, "input.2.call_id").String())
+	require.Equal(t, "9007199254740993", gjson.GetBytes(sanitized, "metadata.sequence").Raw)
+	require.Contains(t, string(body), "resp_oauth", "input body must remain immutable")
+	require.Contains(t, string(body), "ENC", "input body must remain immutable")
+}
