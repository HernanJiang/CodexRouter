+
+type openAIProxyFallbackStep struct {
+	response *http.Response
+	err      error
+}
+
+type openAIProxyFallbackUpstream struct {
+	steps     []openAIProxyFallbackStep
+	proxyURLs []string
+}
+
+func (u *openAIProxyFallbackUpstream) Do(req *http.Request, proxyURL string, _ int64, _ int) (*http.Response, error) {
+	u.proxyURLs = append(u.proxyURLs, proxyURL)
+	if req != nil && req.Body != nil {
+		_, _ = io.Copy(io.Discard, req.Body)
+		_ = req.Body.Close()
+	}
+	if len(u.steps) == 0 {
+		return nil, errors.New("unexpected upstream call")
+	}
+	step := u.steps[0]
+	u.steps = u.steps[1:]
+	return step.response, step.err
+}
+
+func (u *openAIProxyFallbackUpstream) DoWithTLS(req *http.Request, proxyURL string, accountID int64, accountConcurrency int, _ *tlsfingerprint.Profile) (*http.Response, error) {
+	return u.Do(req, proxyURL, accountID, accountConcurrency)
+}
