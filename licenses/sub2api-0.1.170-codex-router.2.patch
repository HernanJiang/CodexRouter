+func hasExplicitOpenAIUpstreamCapacitySignal(responseBody []byte) bool {
+	message := strings.ToLower(string(responseBody))
+	for _, signal := range []string{
+		"overloaded",
+		"over capacity",
+		"capacity exceeded",
+		"server busy",
+		"temporarily unavailable",
+		"try again later",
+	} {
+		if strings.Contains(message, signal) {
+			return true
+		}
+	}
+	return false
+}
