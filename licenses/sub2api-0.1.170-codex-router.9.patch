+func geminiToolsMixServerAndFunctionCalls(tools []any) bool {
+	hasServerTool := false
+	hasFunctionTool := false
+	for _, tool := range tools {
+		toolMap, ok := tool.(map[string]any)
+		if !ok {
+			continue
+		}
+		if _, ok := toolMap["googleSearch"]; ok {
+			hasServerTool = true
+		}
+		if declarations, ok := toolMap["functionDeclarations"].([]any); ok && len(declarations) > 0 {
+			hasFunctionTool = true
+		}
+	}
+	return hasServerTool && hasFunctionTool
+}
