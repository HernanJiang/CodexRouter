+func TestAntigravityCompatResponsesEnablesMixedServerAndFunctionTools(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	upstream := &queuedHTTPUpstreamStub{responses: []*http.Response{antigravityCompatSuccessResponse()}}
+	svc := newAntigravityCompatService(config.GatewayConfig{MaxLineSize: defaultMaxLineSize}, upstream)
+	body := []byte(`{
+		"model":"gemini-3.1-pro-high",
+		"input":"Find the current value and compare it with the local record.",
+		"tools":[
+			{"type":"web_search"},
+			{"type":"function","name":"read_record","description":"Read a local record","parameters":{"type":"object","properties":{"key":{"type":"string"}},"required":["key"]}}
+		]
+	}`)
+	c, _ := newAntigravityCompatContext(http.MethodPost, "/v1/responses", body)
+
+	result, err := svc.ForwardAsResponses(
+		context.Background(),
+		c,
+		newAntigravityCompatAccount(AccountTypeOAuth),
+		body,
+		nil,
+	)
+
+	require.NoError(t, err)
+	require.NotNil(t, result)
+	require.Len(t, upstream.requestBodies, 1)
+	posted := upstream.requestBodies[0]
+	require.True(t, gjson.GetBytes(posted, "request.toolConfig.includeServerSideToolInvocations").Bool())
+	var wrapped map[string]any
+	require.NoError(t, json.Unmarshal(posted, &wrapped))
+	requestBody, ok := wrapped["request"].(map[string]any)
+	require.True(t, ok)
+	tools, ok := requestBody["tools"].([]any)
+	require.True(t, ok)
+	require.Len(t, tools, 2)
+	require.Contains(t, tools[0].(map[string]any), "functionDeclarations")
+	require.Contains(t, tools[1].(map[string]any), "googleSearch")
+	require.Equal(t, "read_record", gjson.GetBytes(posted, "request.tools.0.functionDeclarations.0.name").String())
+}
