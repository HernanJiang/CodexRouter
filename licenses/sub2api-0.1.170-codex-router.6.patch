diff --git a/backend/internal/handler/admin/openai_oauth_identity_test.go b/backend/internal/handler/admin/openai_oauth_identity_test.go
new file mode 100644
index 0000000..2f3bc17
--- /dev/null
+++ b/backend/internal/handler/admin/openai_oauth_identity_test.go
@@ -0,0 +1,87 @@
+package admin
+
+import (
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSelectExistingOpenAIOAuthAccount(t *testing.T) {
+	accounts := []service.Account{
+		{
+			ID:       1,
+			Platform: service.PlatformOpenAI,
+			Type:     service.AccountTypeOAuth,
+			Credentials: map[string]any{
+				"chatgpt_account_id": "acct-stable-1",
+				"chatgpt_user_id":    "user-stable-1",
+				"email":              "same@example.invalid",
+			},
+			GroupIDs: []int64{9},
+		},
+		{
+			ID:       15,
+			Platform: service.PlatformOpenAI,
+			Type:     service.AccountTypeOAuth,
+			Credentials: map[string]any{
+				"chatgpt_account_id": "acct-stable-1",
+				"chatgpt_user_id":    "user-stable-1",
+				"email":              "same@example.invalid",
+			},
+		},
+		{
+			ID:       21,
+			Platform: service.PlatformOpenAI,
+			Type:     service.AccountTypeOAuth,
+			Credentials: map[string]any{
+				"chatgpt_account_id": "acct-stable-2",
+				"chatgpt_user_id":    "user-stable-1",
+				"email":              "same@example.invalid",
+			},
+			GroupIDs: []int64{9},
+		},
+	}
+
+	t.Run("same account id reuses the bound stable row", func(t *testing.T) {
+		match := selectExistingOpenAIOAuthAccount(accounts, map[string]any{
+			"chatgpt_account_id": "acct-stable-1",
+			"chatgpt_user_id":    "user-stable-1",
+			"email":              "same@example.invalid",
+		})
+		require.NotNil(t, match)
+		require.Equal(t, int64(1), match.ID)
+	})
+
+	t.Run("different account ids never merge by email or user id", func(t *testing.T) {
+		match := selectExistingOpenAIOAuthAccount(accounts[:1], map[string]any{
+			"chatgpt_account_id": "acct-stable-2",
+			"chatgpt_user_id":    "user-stable-1",
+			"email":              "same@example.invalid",
+		})
+		require.Nil(t, match)
+	})
+
+	t.Run("user id is used only when account id is unavailable", func(t *testing.T) {
+		withoutAccountID := []service.Account{{
+			ID:       30,
+			Platform: service.PlatformOpenAI,
+			Type:     service.AccountTypeOAuth,
+			Credentials: map[string]any{
+				"chatgpt_user_id": "user-stable-3",
+			},
+		}}
+		match := selectExistingOpenAIOAuthAccount(withoutAccountID, map[string]any{
+			"chatgpt_user_id": "user-stable-3",
+		})
+		require.NotNil(t, match)
+		require.Equal(t, int64(30), match.ID)
+	})
+
+	t.Run("email alone is not an OAuth identity", func(t *testing.T) {
+		match := selectExistingOpenAIOAuthAccount(accounts, map[string]any{
+			"email": "same@example.invalid",
+		})
+		require.Nil(t, match)
+	})
+}
