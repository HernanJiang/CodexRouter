@@ -18,6 +18,44 @@ type OpenAIOAuthHandler struct {
 	openaiOAuthService *service.OpenAIOAuthService
 	adminService       service.AdminService
 	quotaService       *service.OpenAIQuotaService
+	tokenInvalidator   service.TokenCacheInvalidator
+}
+
+func openAIOAuthStableCredential(credentials map[string]any) (string, string) {
+	for _, key := range []string{"chatgpt_account_id", "chatgpt_user_id"} {
+		value, _ := credentials[key].(string)
+		value = strings.TrimSpace(value)
+		if value != "" {
+			return key, value
+		}
+	}
+	return "", ""
+}
+
+func selectExistingOpenAIOAuthAccount(accounts []service.Account, credentials map[string]any) *service.Account {
+	identityKey, identityValue := openAIOAuthStableCredential(credentials)
+	if identityValue == "" {
+		return nil
+	}
+	var selected *service.Account
+	for i := range accounts {
+		candidate := &accounts[i]
+		if candidate.Platform != service.PlatformOpenAI || candidate.Type != service.AccountTypeOAuth {
+			continue
+		}
+		candidateKey, candidateValue := openAIOAuthStableCredential(candidate.Credentials)
+		if candidateKey != identityKey || !strings.EqualFold(candidateValue, identityValue) {
+			continue
+		}
+		candidateBound := len(candidate.GroupIDs) > 0
+		selectedBound := selected != nil && len(selected.GroupIDs) > 0
+		if selected == nil ||
+			(candidateBound && !selectedBound) ||
+			(candidateBound == selectedBound && candidate.ID < selected.ID) {
+			selected = candidate
+		}
+	}
+	return selected
 }
 
