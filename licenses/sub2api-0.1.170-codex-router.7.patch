index 266f806..2bd4ebb 100644
--- a/backend/internal/service/ratelimit_service.go
+++ b/backend/internal/service/ratelimit_service.go
@@ -178,6 +178,10 @@ func (s *RateLimitService) CheckErrorPolicy(ctx context.Context, account *Accoun
 func (s *RateLimitService) HandleUpstreamError(ctx context.Context, account *Account, statusCode int, headers http.Header, responseBody []byte, requestedModel ...string) (shouldDisable bool) {
 	ctx = withTempUnschedulableModel(ctx, requestedModel)
 	customErrorCodesEnabled := account.IsCustomErrorCodesEnabled()
+	if isKimiCodingContextLimitUnauthorized(account, statusCode, responseBody, firstRequestedModel(requestedModel)) {
+		slog.Info("kimi_context_limit_request_not_account_error", "account_id", account.ID, "model", firstRequestedModel(requestedModel))
+		return false
+	}
 
 	// 池模式默认不标记本地账号状态；但管理员显式配置的临时不可调度规则优先。
 	// 401 保留现有认证错误语义，不在这里改变池模式的认证处理。
@@ -397,6 +401,25 @@ func (s *RateLimitService) HandleUpstreamError(ctx context.Context, account *Acc
 	return shouldDisable
 }
 
+func isKimiCodingContextLimitUnauthorized(account *Account, statusCode int, responseBody []byte, requestedModel string) bool {
+	if account == nil || statusCode != http.StatusUnauthorized || account.Type != AccountTypeAPIKey || account.Platform != PlatformOpenAI {
+		return false
+	}
+	baseURL := strings.ToLower(strings.TrimSpace(account.GetOpenAIBaseURL()))
+	if !strings.HasPrefix(baseURL, "https://api.kimi.com/coding/") && baseURL != "https://api.kimi.com/coding" {
+		return false
+	}
+	model := strings.ToLower(strings.TrimSpace(requestedModel))
+	if model != "k3-256k" && !strings.HasSuffix(model, "/k3-256k") {
+		return false
+	}
+	body := strings.ToLower(string(responseBody))
+	return strings.Contains(body, "k3-256k") &&
+		strings.Contains(body, "256k") &&
+		strings.Contains(body, "context") &&
+		(strings.Contains(body, "supports only") || strings.Contains(body, "maximum"))
+}
