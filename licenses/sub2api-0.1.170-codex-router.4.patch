+// Third-party Responses relays should not inherit the much wider high-effort
+// OAuth allowance. Their observed first-output latency is dominated by the
+// provider/network path, and a bounded failover is preferable to leaving a
+// detached Codex request waiting for several minutes.
+func (s *OpenAIGatewayService) openAIPassthroughFirstOutputTimeout(account *Account, reasoningEffort string) time.Duration {
+	if account != nil && account.Type == AccountTypeAPIKey && s != nil && s.cfg != nil {
+		if seconds := s.cfg.Gateway.OpenAIFirstOutputTimeoutSeconds; seconds > 0 {
+			return time.Duration(seconds) * time.Second
+		}
+	}
+	return s.openAIFirstOutputTimeout(reasoningEffort)
+}
