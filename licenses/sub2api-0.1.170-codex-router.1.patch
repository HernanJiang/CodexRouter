+func TestForwardResponses_ThirdPartyNativeResponsesAdaptsCodexClientTools(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+
+	body := []byte(`{
+		"model":"gpt-5.4",
+		"input":[
+			{"role":"user","content":"use the tools"},
+			{"type":"additional_tools","tools":[{"type":"function","name":"extra_lookup","parameters":{"type":"object","properties":{}}}]}
+		],
+		"tools":[
+			{"type":"custom","name":"apply_patch","format":{"type":"text"}},
+			{"type":"tool_search"}
+		],
+		"stream":false
+	}`)
+	rec := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rec)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader(body))
+	c.Request.Header.Set("Content-Type", "application/json")
+
+	upstream := &httpUpstreamRecorder{resp: &http.Response{
+		StatusCode: http.StatusOK,
+		Header:     http.Header{"Content-Type": []string{"application/json"}},
+		Body: io.NopCloser(strings.NewReader(`{
+			"id":"resp_native_tools","object":"response","model":"gpt-5.4","status":"completed",
+			"output":[
+				{"type":"function_call","id":"item_custom","call_id":"call_custom","name":"apply_patch","arguments":"{\"input\":\"patch text\"}"},
+				{"type":"function_call","id":"item_search","call_id":"call_search","name":"tool_search","arguments":"{\"query\":\"repo\"}"}
+			],
+			"usage":{"input_tokens":5,"output_tokens":2,"total_tokens":7}
+		}`)),
+	}}
+	svc := &OpenAIGatewayService{
+		cfg:          rawChatCompletionsTestConfig(),
+		httpUpstream: upstream,
+	}
+	account := rawChatCompletionsTestAccount()
+	account.Extra = map[string]any{
+		openai_compat.ExtraKeyResponsesMode:      string(openai_compat.ResponsesSupportModeAuto),
+		openai_compat.ExtraKeyResponsesSupported: true,
+	}
+
+	result, err := svc.Forward(context.Background(), c, account, body)
+	require.NoError(t, err)
+	require.NotNil(t, result)
+	require.Equal(t, "http://upstream.example/v1/responses", upstream.lastReq.URL.String())
+	require.Len(t, gjson.GetBytes(upstream.lastBody, "tools").Array(), 3)
+	require.Equal(t, "function", gjson.GetBytes(upstream.lastBody, "tools.0.type").String())
+	require.Equal(t, "function", gjson.GetBytes(upstream.lastBody, "tools.1.type").String())
+	require.Equal(t, "function", gjson.GetBytes(upstream.lastBody, "tools.2.type").String())
+	require.False(t, gjson.GetBytes(upstream.lastBody, `input.#(type=="additional_tools")`).Exists())
+	require.Equal(t, "custom_tool_call", gjson.Get(rec.Body.String(), "output.0.type").String())
+	require.Equal(t, "patch text", gjson.Get(rec.Body.String(), "output.0.input").String())
+	require.Equal(t, "tool_search_call", gjson.Get(rec.Body.String(), "output.1.type").String())
+	require.Equal(t, "repo", gjson.Get(rec.Body.String(), "output.1.arguments.query").String())
+}
