{
  "version": "1.7.0",
  "authMode": "chatgpt_oauth",
  "deploy": {
    "codexHome": "",
    "sub2apiHost": "http://127.0.0.1:18080",
    "generateIsolation": true,
    "startWithWindows": true
  },
  "oauthFallback": {
    "enabled": true,
    "preferOAuth": true,
    "officialPriority": 1,
    "fallbackPriority": 100
  },
  "fallbackChannelSelections": {},
  "reasoning": {
    "mode": "auto"
  },
  "proxy": {
    "autoDetect": true,
    "enabled": false,
    "proxyType": "http",
    "host": "127.0.0.1",
    "port": "7890",
    "username": "",
    "passwordCredential": "ProxyPassword"
  },
  "defaultModel": "gpt-5.6-sol",
  "models": [
    {
      "model": "gpt-5.6-sol",
      "alias": "ChatGPT-5.6-Sol",
      "baseURL": "https://api.openai.com/v1",
      "credentialName": "ModelApiKey-gpt-5-6-sol",
      "priority": 10,
      "weight": 1,
      "extra": "{}",
      "multimodal": "auto",
      "contextWindow": 0,
      "autoCompactPercent": 80
    },
    {
      "model": "deepseek-v4-flash",
      "alias": "DeepSeek V4 Flash",
      "baseURL": "https://openrouter.ai/api/v1",
      "credentialName": "ModelApiKey-deepseek-v4-flash",
      "priority": 20,
      "weight": 1,
      "extra": "{}",
      "multimodal": "auto",
      "contextWindow": 0,
      "autoCompactPercent": 80
    }
  ],
  "modelCatalog": [
    {
      "slug": "gpt-5.6-sol",
      "display_name": "ChatGPT-5.6-Sol",
      "description": "Example model",
      "default_reasoning_level": "low",
      "supported_reasoning_levels": [
        {
          "effort": "none",
          "description": "low reasoning level"
        },
        {
          "effort": "medium",
          "description": "medium reasoning level"
        },
        {
          "effort": "high",
          "description": "high reasoning level"
        },
        {
          "effort": "xhigh",
          "description": "xhigh reasoning level"
        },
        {
          "effort": "max",
          "description": "max reasoning level"
        }
      ],
      "shell_type": "shell_command",
      "visibility": "list",
      "supported_in_api": true,
      "priority": 1,
      "additional_speed_tiers": [
        "fast"
      ],
      "service_tiers": [
        {
          "id": "priority",
          "name": "Fast",
          "description": "Faster responses with higher usage"
        }
      ],
      "input_modalities": ["text", "image"],
      "supports_image_detail_original": true,
      "supports_vision": true
    }
  ]
}
